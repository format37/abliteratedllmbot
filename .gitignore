# Secrets & local config — NEVER commit these (public repo).
.env
config.yaml

# Local data / model state. data/ is tracked as an empty dir (.gitkeep) so a
# clone owns it before Docker can create it as root.
data/*
!data/.gitkeep
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
