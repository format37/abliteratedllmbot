# Copy to .env (gitignored) and fill in. The bot token is the ONLY secret.
TELEGRAM_BOT_TOKEN=

# Optional: override any nested config key with the __ delimiter, e.g.
# OLLAMA__MODEL=qwen3.5:27b
# TELEGRAM__ALLOWED_USER_IDS=[106129214]

# Docker Compose only: the container clock is UTC unless you set this, which would
# make /status report the model's unload time in the wrong zone.
# Your host's zone: `timedatectl show -p Timezone`
TZ=Etc/UTC

# Docker Compose only: run the container as your host user so files it writes
# into ./data stay yours instead of root's. Defaults to 1000:1000, which is right
# on most single-user Linux hosts. Only needed if `id -u` prints something else:
#   echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
# UID=1000
# GID=1000

# Under Docker Compose, OLLAMA__HOST already defaults to the host mapping
# (http://host.docker.internal:11434). Only set it here to point somewhere else,
# e.g. when Ollama is a container on a shared network:
# OLLAMA__HOST=http://ollama:11434
